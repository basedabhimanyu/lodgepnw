<!doctype html>
<html lang="en">

<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>LodgePNW – Cinematic Web Design & Integration for Resorts</title>
  <meta name="description"
    content="Elevating the digital experience for resorts & hotels in the USA. Vacation rental software integration and stunning cinematic web design.">

  <!-- Google Fonts for Premium Typography -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link
    href="https://fonts.googleapis.com/css2?family=Outfit:wght@300;400;500;600;700&family=Playfair+Display:ital,wght@0,400;0,600;1,400&display=swap"
    rel="stylesheet">

  <!-- Local CSS -->
  <link rel="stylesheet" href="./style.css" />
</head>

<body>
  <!-- 3D Canvas Background -->
  <canvas id="webgl"></canvas>

  <!-- Navbar -->
  <nav class="navbar">
    <div class="nav-container">
      <a href="#" class="logo">Lodge<span>PNW</span></a>
      <div class="nav-links">
        <a href="#services">Expertise</a>
        <a href="#network">Network</a>
        <a href="#plans">Plans</a>
        <a href="#contact" class="btn btn-primary btn-nav">Inquire Now</a>
      </div>
    </div>
  </nav>

  <!-- Smooth Scroll Container -->
  <div id="smooth-wrapper">
    <div id="smooth-content">

      <main>
        <!-- Hero Section -->
        <section id="hero" class="hero section-padding">
          <div class="container hero-content">
            <div class="hero-badge" data-gsap="fade-up">Cinematic Experiences for Hospitality</div>
            <h1 class="hero-title" data-gsap="fade-up" data-delay="0.1">Digital Landscapes <br> <span
                class="text-gradient">for Premium Stays</span></h1>
            <p class="hero-subtitle" data-gsap="fade-up" data-delay="0.2">We build breathtaking 3D web experiences and
              seamlessly integrate vacation rental software for luxury resorts and hotels across the USA.</p>
            <div class="hero-actions" data-gsap="fade-up" data-delay="0.3">
              <a href="#plans" class="btn btn-primary">View Our Plans</a>
              <a href="#contact" class="btn btn-secondary glass-btn">Get in Touch</a>
            </div>
          </div>
          <div class="scroll-indicator" data-gsap="fade-up" data-delay="0.4">
            <span>Scroll to traverse</span>
            <div class="mouse">
              <div class="wheel"></div>
            </div>
          </div>
        </section>

        <!-- Services / Expertise Section -->
        <section id="services" class="services section-padding">
          <div class="container">
            <div class="section-header">
              <h2 class="section-title" data-gsap="fade-up">Our <span class="text-gradient">Expertise</span></h2>
              <div class="hline" data-gsap="scale-x"></div>
            </div>
            <div class="services-list">
              <div class="service-item" data-gsap="fade-up">
                <div class="service-number">01</div>
                <div class="service-details">
                  <h3>Cinematic Web Design</h3>
                  <p>Moving beyond flat pages. We engineer immersive 3D, scrollytelling experiences that evoke the
                    emotion of your destination and captivate high-end guests.</p>
                </div>
              </div>
              <div class="service-item" data-gsap="fade-up">
                <div class="service-number">02</div>
                <div class="service-details">
                  <h3>Software & PMS Integration</h3>
                  <p>Flawless connection with leading property management systems (PMS) and vacation rental APIs. We
                    align stunning frontends with powerful backend logistics.</p>
                </div>
              </div>
              <div class="service-item" data-gsap="fade-up">
                <div class="service-number">03</div>
                <div class="service-details">
                  <h3>Performance Engineering</h3>
                  <p>Heavy graphics don't mean slow load times. Our architectures are optimized for speed, ensuring
                    instant engagement and superior SEO rankings.</p>
                </div>
              </div>
            </div>
          </div>
        </section>

        <!-- Network Section (Instagrams) -->
        <section id="network" class="network section-padding">
          <div class="container text-center">
            <div class="section-header centered">
              <h2 class="section-title" data-gsap="fade-up">The <span class="text-gradient">Network</span></h2>
              <p class="section-subtitle" data-gsap="fade-up">Tap into our established visual influence. Cultivating
                passionate traveler audiences.</p>
            </div>

            <div class="network-cards">
              <a href="https://instagram.com/visit.the.pnw" target="_blank" class="glass-card" data-gsap="fade-up">
                <div class="card-glow"></div>
                <div class="ig-handle">@visit.the.pnw</div>
                <p>Curating the breathtaking landscapes and unique stays of the Pacific Northwest.</p>
                <span class="explore-link">Explore the PNW <svg viewBox="0 0 24 24" width="16" height="16"
                    stroke="currentColor" stroke-width="2" fill="none">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg></span>
              </a>

              <a href="https://instagram.com/vist.the.states" target="_blank" class="glass-card" data-gsap="fade-up"
                data-delay="0.2">
                <div class="card-glow"></div>
                <div class="ig-handle">@vist.the.states</div>
                <p>Showcasing the finest destinations and luxury resorts across the United States.</p>
                <span class="explore-link">Explore the States <svg viewBox="0 0 24 24" width="16" height="16"
                    stroke="currentColor" stroke-width="2" fill="none">
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg></span>
              </a>
            </div>
          </div>
        </section>

        <!-- Plans Section -->
        <section id="plans" class="plans section-padding">
          <div class="container">
            <div class="section-header">
              <h2 class="section-title" data-gsap="fade-up">Clear <span class="text-gradient">Investment</span></h2>
              <div class="hline" data-gsap="scale-x"></div>
            </div>

            <div class="pricing-container">
              <div class="pricing-card glass-panel" data-gsap="fade-up">
                <h3>Boutique</h3>
                <div class="price">Custom</div>
                <ul class="features">
                  <li>3-Page Cinematic Design</li>
                  <li>Basic Widget Integration</li>
                  <li>Mobile Responsive</li>
                </ul>
                <a href="mailto:hello@lodgepnw.com?subject=Boutique" class="btn btn-outline glass-btn">Select</a>
              </div>

              <div class="pricing-card glass-panel highlighted" data-gsap="fade-up" data-delay="0.1">
                <div class="popular">Most Popular</div>
                <h3>Resort Standard</h3>
                <div class="price">Tailored</div>
                <ul class="features">
                  <li>Up to 8 Custom Pages</li>
                  <li>Full PMS/API Integration</li>
                  <li>Advanced 3D Effects</li>
                  <li>Featured on @visit.the.pnw</li>
                </ul>
                <a href="mailto:hello@lodgepnw.com?subject=Resort Standard" class="btn btn-primary">Select</a>
              </div>

              <div class="pricing-card glass-panel" data-gsap="fade-up" data-delay="0.2">
                <h3>Enterprise</h3>
                <div class="price">Bespoke</div>
                <ul class="features">
                  <li>Unlimited Pages</li>
                  <li>Custom Booking Engine App</li>
                  <li>24/7 Priority Support</li>
                  <li>Featured on both IG Networks</li>
                </ul>
                <a href="mailto:hello@lodgepnw.com?subject=Enterprise" class="btn btn-outline glass-btn">Select</a>
              </div>
            </div>
          </div>
        </section>

        <!-- Contact Section -->
        <section id="contact" class="contact section-padding">
          <div class="container">
            <div class="contact-box glass-card" data-gsap="fade-up">
              <h2>Ready to <span class="text-gradient">Elevate?</span></h2>
              <p>Discuss how we can transform your property's digital presence instantly.</p>

              <div class="contact-methods">
                <a href="https://ig.me/m/visit.the.pnw" target="_blank" class="glass-btn pulse-glow">
                  DM @visit.the.pnw
                </a>
                <a href="mailto:hello@lodgepnw.com" class="glass-btn">
                  hello@lodgepnw.com
                </a>
              </div>
            </div>
          </div>
        </section>

        <!-- Footer -->
        <footer class="footer">
          <div class="container footer-content border-top">
            <div class="footer-brand">
              <a href="#" class="logo">Lodge<span>PNW</span></a>
              <p>Cinematic web design & vacation rental software integration.</p>
            </div>
            <div class="footer-links">
              <a href="https://instagram.com/visit.the.pnw" target="_blank">@visit.the.pnw</a>
              <a href="https://instagram.com/vist.the.states" target="_blank">@vist.the.states</a>
            </div>
          </div>
          <div class="footer-bottom container">
            <p>&copy; 2026 LodgePNW. Digital Hospitality Architecture.</p>
          </div>
        </footer>

      </main>
    </div>
  </div>

  <script type="module" src="./main.js"></script>
</body>

</html>